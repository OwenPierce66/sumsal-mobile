    height: 40,
    borderRadius: 20,
  },
  favoriteInfo: {
    flex: 1,
  },
  favoriteName: {
    color: '#fff',
    fontSize: 14,
    fontWeight: '600',
  },
  favoriteHandle: {
    color: '#999',
    fontSize: 12,
    marginTop: 2,
  },
  noFavoritesContainer: {
